/*
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:
  X-Frame-Options: SAMEORIGIN

# CSS and JS are versioned with ?v= in every page, so browsers can keep them for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Images and videos: instant from cache for a day, then shown from cache while a fresh copy
# is checked in the background (up to 30 days), so repeat visits never wait on them.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/videos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
